        "kind": "bin"
      },
      "PUT": {
        "kind": "commit"
      }
    },
    "n": 0,
    "timestamp": "<Date.toUTCString()>"
  },
  "rel8ns": {
    "bin": [
      "bin <sha256_lowercase>"
    ],
    "policy": [
      "policies/foobarch-shell^<policy_gib>"
    ],
    "past": [],
    "tjp": [],
    "dna": []
  }
}
